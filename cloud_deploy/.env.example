# ============================================================
# 微博舆情系统 - 环境变量配置示例
# 复制为 .env 并填入真实值，不要提交到 Git
# ============================================================

# ---- 数据库连接（TiDB Cloud，必填）----
# 格式: mysql://<user>:<password>@<host>:4000/<dbname>?ssl-mode=VERIFY_IDENTITY
# 从 TiDB Cloud 控制台 Connect 页面复制
DATABASE_URL=mysql://your_user:your_password@your_host.tidbcloud.com:4000/weibo_comments?ssl-mode=VERIFY_IDENTITY

# TiDB CA 证书路径（可选，默认使用系统 CA）
# TIDB_CA_PATH=/app/certs/tidb-ca.pem

# ---- 微博爬虫（GitHub Actions 用，可选）----
# 微博登录 Cookie（如爬虫需要登录态）
WEIBO_COOKIE=

# ---- 飞书日报推送（可选）----
# 飞书群机器人 Webhook
FEISHU_WEBHOOK=

# ---- API 服务（Render 自动注入，无需手动设置）----
# PORT=8000
